  local resizeStart = nil
  local startSize = nil

  Resizer.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
      isResizing = true
      resizeStart = input.Position
      startSize = Main.AbsoluteSize
    end
  end)

  UserInputService.InputChanged:Connect(function(input)
    if isResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
      local delta = input.Position - resizeStart

      local newWidth = math.clamp(startSize.X + delta.X, 400, 1200)
      local newHeight = math.clamp(startSize.Y + delta.Y, 250, 800)

      local newSize = UDim2.new(0, newWidth, 0, newHeight)

      Main.Size = newSize
      DropShadow.Size = newSize
      DropShadowHolder.Size = newSize

      Layers.Size = UDim2.new(1, -(TabWidth + 9 + 18), 1, -59)
      LayersTab.Size = UDim2.new(0, TabWidth, 1, -59)
      ScrollTab.Size = UDim2.new(1, 0, 1, -82) 
    end
  end)

  UserInputService.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and isResizing then
      isResizing = false
    end
  end)

  return Tabs
