          else
            Funcs_Slider:Set(0)
            Callback(Funcs_Slider.Value)
          end
        end)

        Funcs_Slider:Set(tonumber(Default))
        Callback(Funcs_Slider.Value)

        ItemCount += 1
        return Funcs_Slider
      end

