  local function BindAutoResize(Base, ContentLabel, OnResize)
    local function Update()
      ContentLabel.TextWrapped = false
      local lineCount = math.max(1, math.ceil(ContentLabel.TextBounds.X / math.max(ContentLabel.AbsoluteSize.X, 1)))
      ContentLabel.Size = UDim2.new(ContentLabel.Size.X.Scale, ContentLabel.Size.X.Offset, 0, 12 + (12 * lineCount))
      Base.Size = UDim2.new(1, 0, 0, ContentLabel.AbsoluteSize.Y + 33)
      ContentLabel.TextWrapped = true
      if OnResize then OnResize() end
    end
    ContentLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(Update)
    Update()
  end

