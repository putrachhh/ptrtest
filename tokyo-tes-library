  -- [SMOOTH FIX] JumpToIndex() switches page INSTANTLY, ignoring TweenTime/EasingStyle
  -- set above entirely. Next()/Previous() are the only methods that actually animate,
  -- so we step toward the target index using those instead -> tab switch now slides
  -- smoothly like the config above always intended.
  local function AnimatedGoToTab(TargetIndex)
    local CurrentIndex = LayersPageLayout.CurrentPage.LayoutOrder
    if TargetIndex == CurrentIndex then return end
    if TargetIndex > CurrentIndex then
      for _ = CurrentIndex, TargetIndex - 1 do
        LayersPageLayout:Next()
      end
    else
      for _ = CurrentIndex, TargetIndex + 1, -1 do
        LayersPageLayout:Previous()
      end
    end
  end

