          BindText.Text = "..."
          TweenService:Create(BindFrame, TweenInfo.new(0.15), {BackgroundColor3 = Custom.ColorRGB}):Play()
        end)

        UserInputService.InputBegan:Connect(function(input, gameProcessed)
          if isBinding and input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode
            if key == Enum.KeyCode.Escape or key == Enum.KeyCode.Backspace then
                Funcs_Bind.Value = Enum.KeyCode.Unknown
                BindText.Text = "None"
            elseif key ~= Enum.KeyCode.Unknown then
                Funcs_Bind.Value = key
