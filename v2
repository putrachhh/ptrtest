            function SliderFunc:Set(Value)
                Value = tonumber(Value) or cfg.Min
                Value = math.clamp(RoundTo(Value, cfg.Increment), cfg.Min, cfg.Max)
                SliderFunc.Value = Value
                ValueBox.Text = tostring(Value)
                local span = cfg.Max - cfg.Min
                Tween(Fill, 0.1, { Size = UDim2.new(span > 0 and (Value - cfg.Min) / span or 0, 0, 1, 0) })
                local ok, err = pcall(cfg.Callback, Value)
                if not ok then warn("Slider Callback error:", err) end
                ConfigData[configKey] = Value
                SaveConfig()
            end

            local function FromInput(input)
                local scale = math.clamp((input.Position.X - Hit.AbsolutePosition.X) / math.max(1, Hit.AbsoluteSize.X), 0, 1)
                SliderFunc:Set(cfg.Min + (cfg.Max - cfg.Min) * scale)
            end
            Hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Tween(Knob, 0.15, { Size = UDim2.fromOffset(14, 14) })
                    FromInput(input)
                end
            end)
            Bind(UserInputService.InputChanged, function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    FromInput(input)
                end
            end)
            Bind(UserInputService.InputEnded, function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    dragging = false
                    Tween(Knob, 0.15, { Size = UDim2.fromOffset(10, 10) })
                end
            end)
            ValueBox.FocusLost:Connect(function()
                local n = tonumber((ValueBox.Text:gsub("[^%d%.%-]", "")))
                SliderFunc:Set(n or SliderFunc.Value)
            end)

            SliderFunc:Set(cfg.Default)
            CountItem = CountItem + 1
            Elements[configKey] = SliderFunc
            return SliderFunc
        end

