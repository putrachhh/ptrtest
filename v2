-- Nama dari tabel Icons, "rbxassetid://..", atau angka asset id -> link gambar (nil kalau tidak valid)
local function ResolveIcon(icon)
    if icon == nil or icon == "" then return nil end
    if Icons[icon] then return Icons[icon] end
    local s = tostring(icon)
    if s:match("^rbxasset") or s:match("^https?://") then return s end
    if s:match("^%d+$") then return "rbxassetid://" .. s end
    return nil
end

