local WHITE = Color3.fromRGB(255, 255, 255)
local BLACK = Color3.fromRGB(0, 0, 0)

local function New(class, props, parent)
    local inst = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            inst[k] = v
        end
    end
    if parent then inst.Parent = parent end
    return inst
end

local function Corner(inst, radius)
    return New("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local function Tween(inst, time, props, style, dir)
    local t = TweenService:Create(inst,
        TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function rgbString(c)
    return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5),
        math.floor(c.B * 255 + 0.5))
end

-- Pilih teks gelap atau putih otomatis sesuai terang-gelapnya warna aksen
local function GetContrastColor(color)
    local function lin(c)
        if c <= 0.03928 then return c / 12.92 end
        return ((c + 0.055) / 1.055) ^ 2.4
    end
    local lum = 0.2126 * lin(color.R) + 0.7152 * lin(color.G) + 0.0722 * lin(color.B)
    if lum > 0.25 then
        return Color3.fromRGB(10, 10, 10)
    end
    return Color3.fromRGB(255, 255, 255)
end

