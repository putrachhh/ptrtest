                        local list = DropdownFunc.Value
                        local idx = table.find(list, value)
                        if idx then table.remove(list, idx) else table.insert(list, value) end
                        DropdownFunc:Set(list)
                    else
                        DropdownFunc:Set(value)
                        CloseDropdown()
                    end
                end)
