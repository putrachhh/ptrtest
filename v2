    local Tabs = {}
    local TabList = {}
    local CurrentTab

    local function SelectTab(tab)
        if CurrentTab == tab then return end
        CurrentTab = tab
        CloseDropdown()
        for _, t in ipairs(TabList) do
            t.SetActive(t == tab)
        end
        LayersPageLayout:JumpTo(tab.Page)
    end

    SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(SearchBox.Text)
        local jumped = false
        for _, tab in ipairs(TabList) do
            local pageHasMatch = false
            for _, section in ipairs(tab.Page:GetChildren()) do
                if section.Name == "Section" then
                    local any = false
                    for _, d in ipairs(section:GetDescendants()) do
                        local key = d:GetAttribute("SearchKey")
                        if key ~= nil then
                            local match = query == "" or string.find(key, query, 1, true) ~= nil
                            d.Visible = match
                            if match then any = true end
                        elseif d:GetAttribute("Decor") then
                            d.Visible = query == ""
                        end
                    end
                    for _, d in ipairs(section:GetDescendants()) do
                        if d.Name == "Row" and d:IsA("Frame") then
                            local vis = query == ""
                            for _, col in ipairs(d:GetChildren()) do
                                if col:IsA("Frame") then
                                    for _, it in ipairs(col:GetChildren()) do
                                        if it:GetAttribute("SearchKey") ~= nil and it.Visible then vis = true end
                                    end
                                end
                            end
                            d.Visible = vis
                        end
                    end
                    section.Visible = query == "" or any
                    if any and query ~= "" then pageHasMatch = true end
                end
            end
            if pageHasMatch and not jumped then
                jumped = true
                SelectTab(tab)
            end
        end
    end)

