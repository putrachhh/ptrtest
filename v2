-- Simpan config di-debounce supaya slider tidak spam writefile tiap frame
local SavePending = false
function SaveConfig()
    if not writefile then return end
    if SavePending then return end
    SavePending = true
    task.delay(0.35, function()
        SavePending = false
        ConfigData._version = CURRENT_VERSION
        pcall(function()
            writefile(ConfigFile, HttpService:JSONEncode(ConfigData))
        end)
    end)
end

function LoadConfigFromFile()
    if not CURRENT_VERSION then return end

    local isFileSuccess, isFileResult = false, false
    if isfile then
        isFileSuccess, isFileResult = pcall(function() return isfile(ConfigFile) end)
    end

    if isFileSuccess and isFileResult then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(ConfigFile))
        end)
        if success and type(result) == "table" and result._version == CURRENT_VERSION then
            ConfigData = result
        else
            ConfigData = { _version = CURRENT_VERSION }
        end
    else
        ConfigData = { _version = CURRENT_VERSION }
    end
end

function LoadConfigElements()
    for key, element in pairs(Elements) do
        if ConfigData[key] ~= nil and element.Set then
            element:Set(ConfigData[key], true)
        end
    end
end

