            function DropdownFunc:Set(Value)
                if cfg.Multi then
                    DropdownFunc.Value = type(Value) == "table" and Value or {}
                else
                    DropdownFunc.Value = (type(Value) == "table" and Value[1]) or Value
                end
                ConfigData[configKey] = DropdownFunc.Value
                SaveConfig()

                local texts = {}
                for _, Opt in ipairs(Scroll:GetChildren()) do
                    if Opt.Name == "Option" then
                        local v = RealValues[Opt]
                        local selected
                        if cfg.Multi then
                            selected = table.find(DropdownFunc.Value, v) ~= nil
                        else
                            selected = DropdownFunc.Value == v
                        end
                        local Choose = Opt:FindFirstChild("ChooseFrame")
                        local Text = Opt:FindFirstChild("OptionText")
                        if selected then
                            Tween(Choose, 0.2, { Size = UDim2.new(0, 3, 0, 14) })
                            Tween(Opt, 0.2, { BackgroundTransparency = 0.92 })
                            Tween(Text, 0.2, { TextColor3 = WHITE })
                            table.insert(texts, Text.Text)
                        else
                            Tween(Choose, 0.15, { Size = UDim2.new(0, 0, 0, 0) })
                            Tween(Opt, 0.15, { BackgroundTransparency = 1 })
                            Tween(Text, 0.15, { TextColor3 = Color3.fromRGB(200, 200, 200) })
                        end
                    end
                end
                OptionSelecting.Text = (#texts == 0) and placeholder or table.concat(texts, ", ")
                OptionSelecting.TextColor3 = (#texts == 0) and Color3.fromRGB(150, 150, 150) or Color3.fromRGB(235, 235, 235)

                local arg
                if cfg.Multi then
                    arg = DropdownFunc.Value
                else
                    arg = (DropdownFunc.Value ~= nil) and tostring(DropdownFunc.Value) or ""
                end
                local ok, err = pcall(cfg.Callback, arg)
                if not ok then warn("Dropdown Callback error:", err) end
            end

            function DropdownFunc:SetValue(val) self:Set(val) end
            function DropdownFunc:GetValue() return self.Value end

            function DropdownFunc:SetValues(newList, selecting)
                newList = newList or {}
                selecting = selecting or (cfg.Multi and {} or nil)
                DropdownFunc:Clear()
                for _, v in ipairs(newList) do
                    DropdownFunc:AddOption(v)
                end
                DropdownFunc.Options = newList
                DropdownFunc:Set(selecting)
            end

            DropdownFunc:SetValues(DropdownFunc.Options, DropdownFunc.Value)

            CountItem = CountItem + 1
            Elements[configKey] = DropdownFunc
            return DropdownFunc
        end

