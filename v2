            local selectedProfile = "None"

            local function RefreshProfileDropdown()
                local fresh = GetProfileList()
                if #fresh == 0 then table.insert(fresh, "None") end
                if profileDropdown and profileDropdown.SetValues then
                    profileDropdown:SetValues(fresh, fresh[1] or "None")
                end
                selectedProfile = fresh[1] or "None"
                return fresh
            end

            local profiles = GetProfileList()
            if #profiles == 0 then table.insert(profiles, "None") end

            profileDropdown = ConfigSection:AddDropdown({
                Title    = "Select Profile",
                Content  = "Select the profile you want to load or delete",
                Options  = profiles,
                Default  = profiles[1] or "None",
                Multi    = false,
                Callback = function(val) selectedProfile = val end,
            })

            ConfigSection:AddButton({
                Title = "Refresh",
                Icon = "loop",
                Callback = function()
                    local fresh = RefreshProfileDropdown()
                    cnotif("Found " .. tostring(#fresh) .. " profiles", 3)
                end,
            })

            local profileNameInput = ConfigSection:AddInput({
                Title   = "New Profile Name",
                Content = "Type a name to save new profile",
                Default = "",
                Callback = function() end,
            })

            ConfigSection:AddButton({
                Title    = "Save Profile",
                SubTitle = "Load Profile",
                Callback = function()
                    local name = profileNameInput.Value
                    if not name or name == "" or name == "None" then
                        cnotif("Type a profile name first!", 3)
                        return
                    end
                    name = name:gsub("[^%w_%-]", "_")
                    local saved = SaveProfile(name)
                    if saved then
                        cnotif("Profile '" .. name .. "' saved successfully!", 4)
                        task.wait(0.2)
                        local newList = GetProfileList()
                        if not table.find(newList, name) then
                            table.insert(newList, name)
                            table.sort(newList)
                        end
                        for i = #newList, 1, -1 do
                            if newList[i] == "None" and #newList > 1 then table.remove(newList, i) end
                        end
                        if profileDropdown and profileDropdown.SetValues then
                            profileDropdown:SetValues(newList, name)
                        end
                        selectedProfile = name
                    else
                        cnotif("Failed to save profile!", 3)
                    end
                end,
                SubCallback = function()
                    if not selectedProfile or selectedProfile == "" or selectedProfile == "None" then
                        cnotif("Select a profile from the dropdown first!", 3)
                        return
                    end
                    cnotif("Loading '" .. selectedProfile .. "'...", 2)
                    task.spawn(function()
                        if LoadProfile(selectedProfile) then
                            cnotif("Profile '" .. selectedProfile .. "' loaded successfully!", 4)
                        else
                            cnotif("Failed to load profile!", 3)
                        end
                    end)
                end,
            })

            ConfigSection:AddButton({
                Title    = "Delete Profile",
                SubTitle = "Copy Config",
                Callback = function()
                    if not selectedProfile or selectedProfile == "" or selectedProfile == "None" then
                        cnotif("Select the profile you want to delete!", 3)
                        return
                    end
                    if DeleteProfile(selectedProfile) then
                        cnotif("Profile '" .. selectedProfile .. "' deleted!", 3)
                        selectedProfile = "None"
                        local newList = GetProfileList()
                        if #newList == 0 then table.insert(newList, "None") end
                        if profileDropdown and profileDropdown.SetValues then
                            profileDropdown:SetValues(newList, newList[1])
                        end
                    else
                        cnotif("Failed to delete profile!", 3)
                    end
                end,
                SubCallback = function()
                    if setclipboard then
                        setclipboard(HttpService:JSONEncode(ConfigData))
                        cnotif("Config copied to clipboard successfully!", 3)
                    else
                        cnotif("Executor does not support clipboard!", 3)
                    end
                end,
            })

            -- ═══ IMPORT ═══
            local ImportSection = SettingsTab:AddSection("Import Config", true)
            ImportSection:AddPanel({
                Title       = "Paste JSON Config",
                Placeholder = "Paste JSON Config here...",
                ButtonText  = "Import & Load",
                Callback    = function(val)
                    if not val or val == "" then
                        cnotif("JSON Input is empty!", 3)
                        return
                    end
                    local decoded, data = pcall(function() return HttpService:JSONDecode(val) end)
                    if not decoded or type(data) ~= "table" then
                        cnotif("Invalid JSON!", 3)
                        return
                    end
                    for key, v in pairs(data) do
                        ConfigData[key] = v
                    end
                    SaveConfig()
                    for key, element in pairs(Elements) do
                        if ConfigData[key] ~= nil and element.Set then
                            pcall(function() element:Set(ConfigData[key]) end)
                            task.wait(0.02)
                        end
                    end
                    cnotif("Config imported successfully!", 4)
                end,
            })

            -- ═══ TEMA ═══
            local ThemeSection = SettingsTab:AddSection("Theme", true)
            local themePresets = {
                ["Emerald"]  = { color = Color3.fromRGB(0, 214, 143),   color2 = Color3.fromRGB(2, 16, 12) },
                ["Silver"]   = { color = Color3.fromRGB(192, 192, 192), color2 = Color3.fromRGB(10, 10, 10) },
                ["Platinum"] = { color = Color3.fromRGB(229, 228, 226), color2 = Color3.fromRGB(10, 10, 10) },
                ["Crimson"]  = { color = Color3.fromRGB(220, 38, 58),   color2 = Color3.fromRGB(14, 2, 5) },
                ["Ice"]      = { color = Color3.fromRGB(34, 211, 238),  color2 = Color3.fromRGB(0, 8, 14) },
                ["Violet"]   = { color = Color3.fromRGB(160, 30, 255),  color2 = Color3.fromRGB(10, 0, 14) },
                ["Amber"]    = { color = Color3.fromRGB(255, 170, 40),  color2 = Color3.fromRGB(14, 9, 0) },
                ["Rose"]     = { color = Color3.fromRGB(255, 105, 180), color2 = Color3.fromRGB(14, 2, 8) },
            }
            ThemeSection:AddDropdown({
                Title    = "Theme",
                Content  = "Change the accent color of the window",
                Options  = { "Emerald", "Silver", "Platinum", "Crimson", "Ice", "Violet", "Amber", "Rose" },
                Default  = GuiConfig.ThemeName,
                Callback = function(value)
                    local preset = themePresets[value]
                    if preset then
                        Tabs:SetTheme(preset.color, preset.color2)
                    end
                end,
            })
        end)
        if not ok then warn("[ProjectZero] AddConfigTab error:", err) end
    end

    return Tabs
end

return ProjectZero
