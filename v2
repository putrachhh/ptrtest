    local function CloseDropdown()
        if not DropOverlay.Visible then return end
        dropToken = dropToken + 1
        local mine = dropToken
        if ActiveChevron then
            Tween(ActiveChevron, 0.2, { Rotation = 0 })
            ActiveChevron = nil
        end
        Tween(DropOverlay, 0.25, { BackgroundTransparency = 1 })
        Tween(DropPanel, 0.25, { Position = DROP_HIDDEN }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        task.delay(0.27, function()
            if mine == dropToken then DropOverlay.Visible = false end
        end)
    end
    local function OpenDropdown(page, title, chevron)
        dropToken = dropToken + 1
        DropTitle.Text = title
        DropPageLayout:JumpTo(page)
        DropOverlay.Visible = true
        if ActiveChevron and ActiveChevron ~= chevron then
            Tween(ActiveChevron, 0.2, { Rotation = 0 })
        end
        ActiveChevron = chevron
        Tween(chevron, 0.2, { Rotation = 180 })
        Tween(DropOverlay, 0.25, { BackgroundTransparency = 0.5 })
        Tween(DropPanel, 0.32, { Position = DROP_SHOWN }, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    end
